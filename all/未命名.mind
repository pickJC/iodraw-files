{"root":{"data":{"id":"ddyqpph6bmg0","created":1762140611616,"text":"有数现有功能整理","progress":null,"priority":null},"children":[{"data":{"id":"ddyqq98birs0","created":1762140654616,"text":"监控各指标的数据看板","layout":null},"children":[]},{"data":{"id":"ddyr3gb8bds0","created":1762141688764,"text":"监控各个业务系统指标的数据看板","layout":null},"children":[]},{"data":{"id":"ddyr58tf6sw0","created":1762141829178,"text":"申请统计（进件后，后续审核、放款的漏斗数据）","layout":null},"children":[{"data":{"id":"ddyr7185ghc0","created":1762141969383,"text":"按日","layout":null},"children":[]},{"data":{"id":"ddyr7chlm3c0","created":1762141993899,"text":"按月","layout":null},"children":[]}]},{"data":{"id":"ddyr74itbyg0","created":1762141976558,"text":"放款统计","layout":null},"children":[{"data":{"id":"ddyvf1322u80","created":1762153880428,"text":"按借贷开始时间","layout":null},"children":[{"data":{"id":"ddyvfigzxz40","created":1762153918276,"text":"按日","layout":null},"children":[]},{"data":{"id":"ddyvfk7hs340","created":1762153922055,"text":"按月","layout":null},"children":[]}]},{"data":{"id":"ddyvf831ctk0","created":1762153895664,"text":"按放款时间","layout":null},"children":[{"data":{"id":"ddyvfblgzzc0","created":1762153903309,"text":"按日","layout":null},"children":[]},{"data":{"id":"ddyvfdex8gg0","created":1762153907267,"text":"按月","layout":null},"children":[]}]}]},{"data":{"id":"ddyvez9xfsw0","created":1762153876490,"text":"还款统计","layout":null},"children":[{"data":{"id":"ddyvitmhbq00","created":1762154177645,"text":"可以按照借贷日查询的还款统计（每日实还）","layout":null},"children":[]},{"data":{"id":"ddywclt5pao0","created":1762156511559,"text":"多维度还款统计（和上面的区别是，下面区分了还款方式，且区分了还款时间上字段的选择）","layout":null},"children":[{"data":{"id":"ddyxlnhutr40","created":1762160041617,"text":"还款时间维度","layout":null},"children":[]},{"data":{"id":"ddyxltmd48g0","created":1762160054950,"text":"入账时间","layout":null},"children":[]}]},{"data":{"id":"ddyy1heh8m00","created":1762161282178,"text":"应还未还统计（还款日维度，统计每日应还对应的实还）","layout":null},"children":[]}]},{"data":{"id":"ddyyjrbkfm80","created":1762162714325,"text":"合同状态统计：统计自然日下业务累计的数据，区分了资产包","layout":null},"children":[]},{"data":{"id":"ddyyl9zq7g80","created":1762162833332,"text":"分摊统计","layout":null},"children":[{"data":{"id":"ddyyld31fds0","created":1762162840063,"text":"放款分摊","layout":null},"children":[{"data":{"id":"ddyym5np2ko0","created":1762162902262,"text":"该表是将放款金额分摊到每日，即：放款金额/借款天数，可用于计算分摊成本","layout":null},"children":[]}]},{"data":{"id":"ddyylgbiuw00","created":1762162847106,"text":"还款分摊","note":"该表是将收入分摊到每日，是财务角度的收入数据。若不是提前结清，收入均摊到每日，即：各期收入/各期占用天数；若是提前结清，先正常摊，其余全部记到结清日","layout":null},"children":[]}]},{"data":{"id":"ddyyv2e4qrk0","created":1762163600431,"text":"支付渠道统计","layout":null},"children":[]},{"data":{"id":"ddyz0rtvoqg0","created":1762164047623,"text":"额度统计","note":"统计日：授信申请日\n统计授信后提现申请和借款的漏斗数据","layout":null},"children":[]},{"data":{"id":"ddyz2zwwnxc0","created":1762164221949,"text":"融担统计","layout":null},"children":[{"data":{"id":"ddyz3icrj4g0","created":1762164262090,"text":"融担余额统计","note":"截止到统计日日末，融担方是汉辰的还款金额，剩余本金","layout":null},"children":[]},{"data":{"id":"ddyz3n0g1cg0","created":1762164272229,"text":"融担实收分成统计","layout":null},"children":[]}]},{"data":{"id":"ddyzcljmy5s0","created":1762164974313,"text":"白猫贷统计","layout":null},"children":[{"data":{"id":"ddyzcto36f40","created":1762164991996,"text":"渠道数据统计（实时）","layout":null},"children":[]},{"data":{"id":"ddyzczlw56o0","created":1762165004924,"text":"渠道数据统计（漏斗）","layout":null},"children":[]}]},{"data":{"id":"ddyzd57f5fs0","created":1762165017110,"text":"用户信息统计","note":"可查看不同地域/不同年代/不同性别的用户产生的进件、放款、还款数据","layout":null},"children":[]},{"data":{"id":"ddyzdgxnivk0","created":1762165042641,"text":"风控统计","layout":null},"children":[{"data":{"id":"ddyzdklq3jc0","created":1762165050627,"text":"vintage曲线分析","layout":null},"children":[]},{"data":{"id":"ddyzpqov0ow0","created":1762166004247,"text":"首期到期资产统计","layout":null},"children":[]},{"data":{"id":"ddyzpwftix40","created":1762166016761,"text":"逾期统计","layout":null},"children":[]},{"data